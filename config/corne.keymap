#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define WBASE 0
#define MBASE 1
#define GAME 2
#define NUM 3
#define WNAV 4
#define ADJ 5
#define MNAV 6
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            require-prior-idle-ms = <120>; /* tune to taste */
        };

        para: para {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;
        };

        caps: caps {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
            continue-list = <MINUS BACKSPACE>;
        };

        paraless: paraless {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp LESS_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        paragreat: paragreat {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

	// TAP DANCES THAT I USE
	   ex_esc: excl_escape {
		 compatible = "zmk,behavior-tap-dance";
		 #binding-cells = <0>;
           bindings = <&kp EXCL>, <&kp ESC>;
	   };

	   min_prt_w: minus_print_windows {
		 compatible = "zmk,behavior-tap-dance";
		 #binding-cells = <0>;
           bindings = <&kp MINUS>, <&kp PSCRN>;
	   };

	   min_prt_m: minus_print_mac {
		 compatible = "zmk,behavior-tap-dance";
		 #binding-cells = <0>;
           bindings = <&kp MINUS>, <&kp LG(LS(N5))>;
	   };
	
    };

    macros {
        browsertab: browsertab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LCTRL>;
        };

    combos {
	   compatible = "zmk,combos";

	   left_parenthesis {
	   		bindings = <&kp LPAR>;
			key-positions = <5 17>;
			layers = <WBASE MBASE>;
	   };
	};

    };


    //

    keymap {
        compatible = "zmk,keymap";

        WBASE {
            display-name = "WBase";

            // -----------------------------------------------------------------------------------------
            // |  !  |  Q  |  W  |  F  |  P   |    G     |===|  J  |   L    |  U  |  Y  |  ;  |  -  |
            // |  =  |  A  |  R  |  S  |  T   |    D     |===|  H  |   N    |  E  |  I  |  O  |  '  |
            // |  `  |  Z  |  X  |  C  |  V   |    B     |===|  N  |   M    |  ,  |  .  |  /  |  \  |
            //                   | DEL | BKSP | LC(BKSP) |===| TAB | SPACE  | RET |

            bindings = <
&ex_esc         &kp Q  &kp W  &kp F       &kp P             &kp G                 &kp J         &kp L      &kp U          &kp Y    &kp SEMI  &min_prt_w
&mt LGUI EQUAL  &kp A  &kp R  &kp S       &kp T             &kp D                 &kp H         &kp N      &kp E          &kp I    &kp O     &kp SQT
&mt LALT GRAVE  &kp Z  &kp X  &kp C       &kp V             &kp B                 &kp K         &kp M      &kp COMMA      &kp DOT  &kp FSLH  &kp BSLH
                         &lt NUM DEL &mt LSHIFT BKSP   &mt LCTRL LC(BKSP)    &mt LALT TAB  &kp SPACE  &lt WNAV RET
            >;
        };

	MBASE {
            display-name = "MBase";

            // -----------------------------------------------------------------------------------------
            // |  !  |  Q  |  W  |  F  |  P   |    G     |===|  J  |   L    |  U  |  Y  |  ;  |  -  |
            // |  =  |  A  |  R  |  S  |  T   |    D     |===|  H  |   N    |  E  |  I  |  O  |  '  |
            // |  `  |  Z  |  X  |  C  |  V   |    B     |===|  N  |   M    |  ,  |  .  |  /  |  \  |
            //                   | DEL | BKSP | LC(BKSP) |===| TAB | SPACE  | RET |

            bindings = <
&ex_esc          &kp Q  &kp W  &kp F       &kp P             &kp G                 &kp J         &kp L      &kp U          &kp Y    &kp SEMI  &min_prt_m
&mt LCTRL EQUAL  &kp A  &kp R  &kp S       &kp T             &kp D                 &kp H         &kp N      &kp E          &kp I    &kp O     &kp SQT
&mt LALT GRAVE   &kp Z  &kp X  &kp C       &kp V             &kp B                 &kp K         &kp M      &kp COMMA      &kp DOT  &kp FSLH  &kp BSLH
                         &lt NUM DEL &mt LSHIFT BKSP   &mt LGUI LA(BKSP)     &mt LALT TAB  &kp SPACE  &lt MNAV RET
            >;
        };

	GAME {
            display-name = "Game";

            // -----------------------------------------------------------------------------------------
            // | TAB |  Q  |  W  |  E  |  R   |    T     |===|  Y  |   U    |  I  |  O  |  P  |  -  |
            // | ESC |  A  |  S  |  D  |  F   |    G     |===|  H  |   J    |  K  |  L  |  ;  |  '  |
            // | SHFT|  Z  |  X  |  C  |  V   |    B     |===|  N  |   M    |  ,  |  .  |  /  |  \  |
            //                   | DEL | SPACE|    BKSP  |===| TAB | SPACE  | RET |

            bindings = <
&kp TAB     &kp Q  &kp W  &kp E       &kp R       &kp T     &kp Y    &kp U      &kp I          &kp O    &kp P     &kp MINUS
&kp ESC     &kp A  &kp S  &kp D       &kp F       &kp G     &kp H    &kp J      &kp K          &kp L    &kp SEMI  &kp SQT
&kp LSHIFT  &kp Z  &kp X  &kp C       &kp V       &kp B     &kp N    &kp M      &kp COMMA      &kp DOT  &kp FSLH  &kp BSLH
                         &kp DEL     &kp SPACE   &kp BKSP  &kp TAB  &kp SPACE  &lt ADJ RET
            >;
        };

        NUM {
            display-name = "Numbers";

            // -----------------------------------------------------------------------------------------
            // |  +   |  !  |  @  |  #  |  $  |  %  |===|  ^  |  &  |  *  |  (  |  )  |  _   |
            // |  =   |  1  |  2  |  3  |  4  |  5  |===|  6  |  7  |  8  |  9  |  0  |  -   |
            // |      |     |  (  |  {  |  [  |     |===|     |  ]  |  }  |  )  |     |      |
            //                    |     |     |     |===|  .  | SPC |  ,  |

            bindings = <
&kp PLUS   &kp EXCL  &kp AT    &kp HASH     &kp DLLR         &kp PRCNT        &kp CARET &kp AMPS  &kp STAR  &kp LPAR     &kp RPAR         &kp UNDER
&kp EQUAL  &kp N1    &kp N2    &kp N3       &kp N4           &kp N5           &kp N6    &kp N7    &kp N8    &kp N9       &kp N0           &kp MINUS
&trans     &trans    &kp LPAR  &kp LBRC     &kp LBKT         &trans           &trans    &kp RBKT  &kp RBRC  &kp RPAR     &trans           &trans
                               &trans       &trans           &trans           &kp DOT   &kp SPACE &lt ADJ COMMA 
            >;
        };

        WNAV {
            display-name = "WNavigation";

            // -----------------------------------------------------------------------------------------
            // |     | SCRL< | SCRLv | SCRL^ | SCRL> |      |===|     | WORD<| WORDv| WORD^| WORD>|      |
            // |     | MOVE< | MOVEv | MOVE^ | MOVE> |      |===|     |  <   |  v   |  ^   |  >   |      |
            // |     |       |       | PGBK  | PGFWD |      |===|     | HOME | PGDN | PGUP | END  |      |
            //                       | MCLK  | LCLK  | RCLK |===|     |      |      |

            bindings = <
&trans  &msc SCRL_LEFT    &msc SCRL_DOWN  &msc SCRL_UP    &msc SCRL_RIGHT   &trans      &trans    &kp LC(LEFT)  &kp LC(DOWN)    &kp LC(UP)      &kp LC(RIGHT)    &trans 
&trans  &mmv MOVE_LEFT    &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT   &trans      &trans    &kp LEFT      &kp DOWN        &kp UP          &kp RIGHT        &trans 
&trans  &trans            &trans          &kp LA(LEFT)    &kp LA(RIGHT)     &trans      &trans    &kp HOME      &kp PG_DN       &kp PG_UP       &kp END          &trans
                                          &lt ADJ MCLK    &mkp LCLK         &mkp RCLK   &trans    &trans        &trans
            >;
        };

	MNAV {
            display-name = "MNavigation";

            // -----------------------------------------------------------------------------------------
            // |     | SCRL< | SCRLv | SCRL^ | SCRL> |      |===|     | WORD<| WORDv| WORD^| WORD>|      |
            // |     | MOVE< | MOVEv | MOVE^ | MOVE> |      |===|     |  <   |  v   |  ^   |  >   |      |
            // |     |       |       | PGBK  | PGFWD |      |===|     | HOME | PGDN | PGUP | END  |      |
            //                       | MCLK  | LCLK  | RCLK |===|     |      |      |

            bindings = <
&trans  &msc SCRL_LEFT    &msc SCRL_DOWN  &msc SCRL_UP    &msc SCRL_RIGHT   &trans      &trans    &kp LA(LEFT)  &kp LA(DOWN)    &kp LA(UP)      &kp LA(RIGHT)    &trans 
&trans  &mmv MOVE_LEFT    &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT   &trans      &trans    &kp LEFT      &kp DOWN        &kp UP          &kp RIGHT        &trans 
&trans  &trans            &trans          &kp LG(LBKT)    &kp LG(RBKT)      &trans      &trans    &kp HOME      &kp PG_DN       &kp PG_UP       &kp END          &trans
                                          &lt ADJ MCLK    &mkp LCLK         &mkp RCLK   &trans    &trans        &trans
            >;
        };

	ADJ {
            display-name = "System";

	    // -----------------------------------------------------------------------------------------
            // |  F1 |   F2  |   F3  |   F4  |   F5  |  F6  |===|  F7 |  F8  |  F9  |  F10 | F11 |  F12 |
            // |     |       | GAME  | MBASE | WBASE |      |===|     | VOLv | VOL^ | BRIv | BRI^|      |
            // |     |       |       |       |       |      |===|     | MUTE | Play |      |     |      |
            //                       |       | STDLK |      |===|     |      |      |

            bindings = <
&kp F1  &kp F2          &kp F3           &kp F4          &kp F5              &kp F6            &kp F7       &kp F8         &kp F9       &kp F10        &kp F11       &kp F12
&trans  &trans          &to GAME         &to MBASE       &to WBASE           &trans            &trans       &kp C_VOL_DN   &kp C_VOL_UP &kp C_BRI_DN   &kp C_BRI_UP  &trans
&trans  &trans          &trans           &trans          &trans              &trans            &trans       &kp C_MUTE     &kp C_PP     &trans         &trans        &trans
                                         &trans          &studio_unlock      &trans            &trans       &bootloader    &trans
            >;
        };

    };

};
 
