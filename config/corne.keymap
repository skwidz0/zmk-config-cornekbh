#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define WBASE 0
#define NUM 1
#define WNAV 2
#define ADJ 3
#define MBASE 4
#define MNAV 5
#define GAME 6
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            require-prior-idle-ms = <120>; /* tune to taste */
        };

        para: para {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;
        };

        caps: caps {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
            continue-list = <MINUS BACKSPACE>;
        };

        paraless: paraless {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp LESS_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        paragreat: paragreat {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    macros {
        browsertab: browsertab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LCTRL>;
        };

    combos {
	compatible = "zmk,combos";

	
	};

    };


    //

    keymap {
        compatible = "zmk,keymap";

        WBASE {
            display-name = "WBase";

            // -----------------------------------------------------------------------------------------
            // |  =  |  Q  |  W  |  F  |  P   |    G     |===|  J  |   L    |  U  |  Y  |  ;  |  -  |
            // | ESC |  A  |  R  |  S  |  T   |    D     |===|  H  |   N    |  E  |  I  |  O  |  '  |
            // |  `  |  Z  |  X  |  C  |  V   |    B     |===|  N  |   M    |  ,  |  .  |  /  |  \  |
            //                   | DEL | BKSP | LC(BKSP) |===| TAB | SPACE  | RET |

            bindings = <
&kp EQUAL  &kp Q  &kp W  &kp F     &kp P             &kp G                 &kp J    &kp L      &kp U          &kp Y    &kp SEMI  &kp MINUS
&kp ESC    &kp A  &kp R  &kp S     &kp T             &kp D                 &kp H    &kp N      &kp E          &kp I    &kp O     &kp SQT
&kp GRAVE  &kp Z  &kp X  &kp C     &kp V             &kp B                 &kp K    &kp M      &kp COMMA      &kp DOT  &kp FSLH  &kp BSLH
                         &lt 1 DEL &mt LSHIFT BKSP   &mt LCTRL LC(BKSP)    &kp TAB  &kp SPACE  &lt 2 RET
            >;
        };

        NUM {
            display-name = "Numbers";

            // -----------------------------------------------------------------------------------------
            // |  +   |  !  |  @  |  #  |  $  |  %  |===|  ^  |  &  |  *  |  (  |  )  |  _   |
            // |  =   |  1  |  2  |  3  |  4  |  5  |===|  6  |  7  |  8  |  9  |  0  |  -   |
            // |      |     |  (  |  {  |  [  |     |===|     |  ]  |  }  |  )  |     |      |
            //                    |     |     |     |===|  .  | SPC |  ,  |

            bindings = <
&kp PLUS   &kp EXCL  &kp AT    &kp HASH     &kp DLLR         &kp PRCNT        &kp CARET &kp AMPS  &kp STAR  &kp LPAR     &kp RPAR         &kp UNDER
&kp EQUAL  &kp N1    &kp N2    &kp N3       &kp N4           &kp N5           &kp N6    &kp N7    &kp N8    &kp N9       &kp N0           &kp MINUS
&trans     &trans    &kp LPAR  &kp LBRC     &kp LBKT         &trans           &trans    &kp RBKT  &kp RBRC  &kp RPAR     &trans           &trans
                               &trans       &trans           &trans           &kp DOT   &kp SPACE &lt 3 COMMA 
            >;
        };

        WNAV {
            display-name = "WNavigation";

            // -----------------------------------------------------------------------------------------
            // |     | SCRL< | SCRLv | SCRL^ | SCRL> |      |===|     | WORD<| WORDv| WORD^| WORD>|      |
            // |     | MOVE< | MOVEv | MOVE^ | MOVE> |      |===|     |  <   |  v   |  ^   |  >   |      |
            // |     |       |       |       |       |      |===|     | HOME | PGDN | PGUP | END  |      |
            //                       | MCLK  | LCLK  | RCLK |===|     |      |      |

            bindings = <
&trans  &msc SCRL_LEFT    &msc SCRL_DOWN  &msc SCRL_UP    &msc SCRL_RIGHT   &trans      &trans    &kp LC(LEFT)  &kp LC(DOWN)    &kp LC(UP)      &kp LC(RIGHT)    &trans 
&trans  &mmv MOVE_LEFT    &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT   &trans      &trans    &kp LEFT      &kp DOWN        &kp UP          &kp RIGHT        &trans 
&trans  &trans            &trans          &kp LA(LEFT)    &kp LA(RIGHT)     &trans      &trans    &kp HOME      &kp PG_DN       &kp PG_UP       &kp END          &trans
                                          &lt 3 MCLK      &mkp LCLK         &mkp RCLK   &trans    &trans        &trans
            >;
        };

        ADJ {
            display-name = "System";

	    // -----------------------------------------------------------------------------------------
            // |  F1 |   F2  |   F3  |   F4  |   F5  |  F6  |===|  F7 |  F8  |  F9  |  F10 | F11 |  F12 |
            // |     | MOVE< | MOVEv | MOVE^ | MOVE> |      |===| MUTE| VOLv | VOL^ | BRIv | BRI^|      |
            // |     |  WIN< | WINv  | WIN^  | WIN>  |      |===|     | PSCRN| Play |      |     |      |
            //                       |       | STDLK |      |===|     |      |      |

            bindings = <
&kp F1  &kp F2          &kp F3           &kp F4          &kp F5              &kp F6            &kp F7       &kp F8         &kp F9       &kp F10        &kp F11       &kp F12
&trans  &kp LS(LA(TAB)) &kp LA(TAB)      &kp LS(LC(TAB)) &kp LC(TAB)         &trans            &kp C_MUTE   &kp C_VOL_DN   &kp C_VOL_UP &kp C_BRI_DN   &kp C_BRI_UP  &trans
&trans  &kp LG(LEFT)    &kp LG(DOWN)     &kp LG(UP)      &kp LG(RIGHT)       &trans            &trans       &kp PSCRN      &kp C_PP     &trans         &trans        &trans
                                         &trans          &studio_unlock      &trans            &trans       &bootloader    &trans
            >;
        };

        MBASE {
            display-name = "MBase";

            // -----------------------------------------------------------------------------------------
            // |  =  |  Q  |  W  |  F  |  P   |    G     |===|  J  |   L    |  U  |  Y  |  ;  |  -  |
            // | ESC |  A  |  R  |  S  |  T   |    D     |===|  H  |   N    |  E  |  I  |  O  |  '  |
            // |  `  |  Z  |  X  |  C  |  V   |    B     |===|  N  |   M    |  ,  |  .  |  /  |  \  |
            //                   | DEL | BKSP | LC(BKSP) |===| TAB | SPACE  | RET |

            bindings = <
&kp EQUAL  &kp Q  &kp W  &kp F     &kp P             &kp G                 &kp J    &kp L      &kp U          &kp Y    &kp SEMI  &kp MINUS
&kp ESC    &kp A  &kp R  &kp S     &kp T             &kp D                 &kp H    &kp N      &kp E          &kp I    &kp O     &kp SQT
&kp GRAVE  &kp Z  &kp X  &kp C     &kp V             &kp B                 &kp K    &kp M      &kp COMMA      &kp DOT  &kp FSLH  &kp BSLH
                         &lt 1 DEL &mt LSHIFT BKSP   &mt LGUI LA(BKSP)    &kp TAB  &kp SPACE  &lt 2 RET
            >;
        };
    };

};
 
